# Runtime options. Adjust Xmx to the server memory budget.
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Singapore
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# MySQL 8. Use a dedicated application account, never root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=home_work
DB_USERNAME=homework_app
DB_PASSWORD=replace-with-a-strong-password

# Fresh databases: enabled=true and baseline-on-migrate=false.
# Existing non-empty databases without Flyway history: back up first, set
# baseline-on-migrate=true for the first successful start only, then restore false.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_DB_USERNAME=homework_migrator
FLYWAY_DB_PASSWORD=replace-with-a-separate-migration-password

# At least 32 random bytes. Generate independently from the admin JWT key.
JWT_SECRET_KEY=replace-with-openssl-rand-base64-48
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret

# Private COS bucket and a least-privilege CAM sub-account.
TENCENT_COS_REGION=replace-with-cos-region
TENCENT_COS_SECRET_ID=replace-with-cam-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cam-secret-key
TENCENT_COS_BUCKET=replace-with-bucket-appid
TENCENT_COS_READ_URL_TTL_SECONDS=3600

# Redis：验证码、发送限流和SecureTicket都依赖它
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0
REDIS_HEALTH_ENABLED=true

# 腾讯云SES邮件推送
TENCENT_SES_SECRET_ID=replace-with-ses-cam-secret-id
TENCENT_SES_SECRET_KEY=replace-with-ses-cam-secret-key
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM_EMAIL=replace-with-approved-ses-sender-address
TENCENT_SES_TEMPLATE_ID=replace-with-approved-ses-template-id

# Keep optional integrations disabled until their production callbacks are ready.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONNECT_TIMEOUT=5s
LLM_READ_TIMEOUT=60s

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

WECHAT_OAUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

QQ_OAUTH_ENABLED=false
QQ_CONNECT_APP_ID=
QQ_CONNECT_APP_KEY=
QQ_CONNECT_REDIRECT_URI=

WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/etc/homework/keys/wechat-merchant-private-key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=/etc/homework/keys/wechat-pay-public-key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://app.example.com/api/payment/wechat/native/notify
WECHAT_PAY_ZONE_ID=Asia/Shanghai
WECHAT_PAY_PRODUCT_DESCRIPTION=Homework会员订阅
