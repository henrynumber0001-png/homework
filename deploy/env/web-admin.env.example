JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Singapore
SERVER_ADDRESS=127.0.0.1
ADMIN_SERVER_PORT=8081

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=home_work
DB_USERNAME=homework_admin
DB_PASSWORD=replace-with-a-strong-password

FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_DB_USERNAME=homework_migrator
FLYWAY_DB_PASSWORD=replace-with-a-separate-migration-password

# Generate separately from JWT_SECRET_KEY.
ADMIN_JWT_ISSUER=homework-admin
ADMIN_JWT_SECRET_KEY=replace-with-openssl-rand-base64-48
ADMIN_JWT_TTL_SECONDS=7200

# Only needed for the first start that creates the built-in super administrator.
# Remove ADMIN_SUPER_PASSWORD from this file after the account exists.
ADMIN_SUPER_EMAIL=admin@example.com
ADMIN_SUPER_PASSWORD=replace-with-a-unique-initial-password
ADMIN_SUPER_DISPLAY_NAME=Super Admin
ADMIN_PUBLIC_BASE_URL=https://admin.example.com/admin/invitation
ADMIN_IMPORT_TEMP_DIR=/var/lib/homework/admin-imports

# 腾讯云SES邮件推送
TENCENT_SES_SECRET_ID=replace-with-ses-cam-secret-id
TENCENT_SES_SECRET_KEY=replace-with-ses-cam-secret-key
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM_EMAIL=replace-with-approved-ses-sender-address
TENCENT_SES_TEMPLATE_ID=replace-with-approved-ses-template-id

TENCENT_COS_REGION=replace-with-cos-region
TENCENT_COS_SECRET_ID=replace-with-cam-secret-id
TENCENT_COS_SECRET_KEY=replace-with-cam-secret-key
TENCENT_COS_BUCKET=replace-with-bucket-appid
TENCENT_COS_READ_URL_TTL_SECONDS=3600
